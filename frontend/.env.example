# ==============================================================================
# Privacy Eye Frontend — Production Environment Configuration Template
# Set these variables in Vercel Project Settings > Environment Variables.
# NOTE: Only prefix variables with NEXT_PUBLIC_ if they are safe for the browser!
# NEVER put DATABASE_URL, HF_TOKEN, or SECRET_KEY here!
# ==============================================================================

# Public URL of the FastAPI backend (ending with /api/v1)
NEXT_PUBLIC_API_URL=https://api.privacy-eye.com/api/v1

# Public URL of the frontend deployment
NEXT_PUBLIC_APP_URL=https://privacy-eye.vercel.app

# Optional: Direct link to backend OpenAPI / Swagger documentation
NEXT_PUBLIC_API_DOCS_URL=https://api.privacy-eye.com/docs

# Application display name
NEXT_PUBLIC_APP_NAME=Privacy Eye
