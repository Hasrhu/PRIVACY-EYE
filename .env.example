# =============================================
# PRIVACY EYE — ENVIRONMENT VARIABLES EXAMPLE
# =============================================
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.

# ----- Application -----
APP_ENV=development
APP_SECRET_KEY=your-super-secret-key-here-min-32-chars
APP_DEBUG=true

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://privacyeye:password@localhost:5432/privacyeye_db
DATABASE_URL_SYNC=postgresql://privacyeye:password@localhost:5432/privacyeye_db

# ----- JWT Auth -----
JWT_SECRET_KEY=your-jwt-secret-key-here-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- AI Agents — Google Gemini -----
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ----- File Upload -----
MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=500
MAX_AUDIO_SIZE_MB=50
TEMP_UPLOAD_DIR=./tmp/uploads
TEMP_RETENTION_MINUTES=30

# ----- CORS -----
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ----- Rate Limiting -----
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_UPLOADS_PER_HOUR=20

# ----- ML Models -----
ML_MODELS_DIR=../ml/weights
ML_DEVICE=cpu
# Set to "cuda" if you have a GPU available
# ML_DEVICE=cuda

# ----- Frontend -----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=Privacy Eye
NEXT_PUBLIC_APP_VERSION=1.0.0-mvp

# ----- Storage (Production: replace with S3) -----
STORAGE_BACKEND=local
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=privacy-eye-uploads
# AWS_REGION=us-east-1
