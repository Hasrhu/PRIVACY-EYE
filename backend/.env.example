# ==============================================================================
# Privacy Eye Backend — Production Environment Configuration Template
# Copy this file to .env and provide your actual deployment secrets.
# NEVER commit .env to Git or public repositories.
# ==============================================================================

# Application Environment (production, staging, development)
APP_ENV=production
APP_SECRET_KEY=replace-with-a-secure-random-32-char-string
APP_DEBUG=false
APP_VERSION=1.0.0

# Database Configuration (PostgreSQL recommended for production)
# Browser NEVER connects to PostgreSQL directly; only FastAPI connects via asyncpg.
DATABASE_URL=postgresql+asyncpg://your_user:your_password@your_db_host:5432/privacyeye
DATABASE_URL_SYNC=postgresql://your_user:your_password@your_db_host:5432/privacyeye

# JWT Authentication
JWT_SECRET_KEY=replace-with-a-secure-jwt-signing-key-32-chars-min
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated for multiple production domains)
CORS_ORIGINS=https://privacy-eye.vercel.app,http://localhost:3000

# Hugging Face Hub / External Model Storage
MODEL_REPOSITORY=privacy-eye/privacy-eye-models
MODEL_REVISION=main
MODEL_CACHE_DIR=./models_cache
# Hugging Face user access token (required only for private repos; public models don't need this)
HF_TOKEN=
AUTO_DOWNLOAD_MODELS=true
ML_DEVICE=cpu

# Google Gemini API for AI Agent Explainability (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Upload File Limits & Retention
MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=500
MAX_AUDIO_SIZE_MB=50
TEMP_UPLOAD_DIR=./tmp/uploads
TEMP_RETENTION_MINUTES=30

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_UPLOADS_PER_HOUR=20
